<?xml version="1.0" encoding="utf-8"?>
<!--
  rviz.wxs - WiX Toolset v5 source for the RViz (ROS Noetic) MSI.

  Required preprocessor variables (passed with -d by build-rviz-msi.ps1):
    ProductName, ProductKey, Manufacturer, ProductVersion, UpgradeCode,
    InstallPrefix (no trailing backslash), AssetsDir, AboutUrl
  Required bind path:
    payload = staged, relocated runtime tree (harvested with <Files>)

  The payload is a conda environment whose text prefixes were rewritten to
  InstallPrefix at build time, therefore the install directory is fixed:
  SetDirectory forces INSTALLFOLDER and the UI offers no "Browse..." button.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="$(var.ProductName)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="$(var.ProductName) $(var.ProductVersion) - 3D visualization tool for ROS, with a private ROS Noetic runtime" />

    <!-- Remove the old version completely before installing the new one:
         most conda DLLs carry no version resource, so in-place file
         versioning rules would leave stale files behind. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you need to downgrade." />

    <!-- Several embedded cabinets keep each one well below the 2 GB cab limit. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="1024" />

    <Launch Condition="Installed OR VersionNT64"
            Message="[ProductName] requires 64-bit Windows 10 or Windows 11." />
    <Launch Condition="Installed OR VersionNT64 &gt;= 603"
            Message="[ProductName] requires Windows 10 or Windows 11." />

    <Icon Id="rviz.ico" SourceFile="$(var.AssetsDir)\rviz.ico" />
    <Property Id="ARPPRODUCTICON" Value="rviz.ico" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.AboutUrl)" />
    <Property Id="ARPHELPLINK" Value="$(var.AboutUrl)" />
    <Property Id="ARPCOMMENTS" Value="Installed to $(var.InstallPrefix)" />

    <!-- Fixed install location (see header). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductKey)" />
    </StandardDirectory>
    <SetDirectory Id="INSTALLFOLDER" Value="$(var.InstallPrefix)\" Sequence="both" />

    <!-- Used by RemoveFolderEx; literal path so it is available on uninstall. -->
    <Property Id="RVIZ_CLEANUP_ROOT" Value="$(var.InstallPrefix)\" />

    <!-- ===== Payload: every file of the staged runtime ======================== -->
    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.payload)\**" />
    </ComponentGroup>

    <ComponentGroup Id="CoreRegistration" Directory="INSTALLFOLDER">
      <Component Id="RegistryInfo">
        <RegistryKey Root="HKLM" Key="Software\$(var.Manufacturer)\$(var.ProductKey)">
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" />
          <RegistryValue Name="RosDistro" Type="string" Value="noetic" />
        </RegistryKey>
      </Component>
      <Component Id="Cleanup">
        <!-- Removes runtime leftovers (e.g. .pyc caches) on uninstall. -->
        <util:RemoveFolderEx On="uninstall" Property="RVIZ_CLEANUP_ROOT" />
        <RegistryValue Root="HKLM" Key="Software\$(var.Manufacturer)\$(var.ProductKey)"
                       Name="Cleanup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ===== Start menu =========================================================
         Shortcut components use an HKCU key path: ICE38/ICE43 require it for
         components in profile folders even in perMachine packages (ICE57
         then only warns). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="$(var.ProductName)">
        <Component Id="StartMenuShortcuts">
          <Shortcut Id="StartRviz" Name="RViz"
                    Description="3D visualization tool for ROS (connects to ROS_MASTER_URI)"
                    Target="[INSTALLFOLDER]launchers\rviz.cmd"
                    WorkingDirectory="INSTALLFOLDER" Icon="rviz.ico" />
          <Shortcut Id="StartRoscore" Name="roscore"
                    Description="Start a local ROS master"
                    Target="[INSTALLFOLDER]launchers\roscore.cmd"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="StartRosShell" Name="ROS Noetic Shell"
                    Description="Command prompt with the bundled ROS environment"
                    Target="[INSTALLFOLDER]launchers\ros_shell.cmd" Arguments="--home"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="StartNotices" Name="Third-party notices"
                    Target="[INSTALLFOLDER]THIRD_PARTY_NOTICES.txt" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.ProductKey)"
                         Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ===== Desktop (optional, off by default) ================================ -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopRviz" Name="RViz (ROS Noetic)"
                  Target="[INSTALLFOLDER]launchers\rviz.cmd"
                  WorkingDirectory="INSTALLFOLDER" Icon="rviz.ico" />
        <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.ProductKey)"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ===== PATH (optional) ===================================================
         Only the launchers folder goes on PATH, appended at the end, so the
         bundled DLLs never shadow other software and an existing ROS install
         keeps priority. -->
    <ComponentGroup Id="PathGroup" Directory="INSTALLFOLDER">
      <Component Id="PathEnv">
        <Environment Id="PathLaunchers" Name="PATH" Value="[INSTALLFOLDER]launchers"
                     Part="last" Action="set" System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\$(var.Manufacturer)\$(var.ProductKey)"
                       Name="OnPath" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ===== Features =========================================================== -->
    <Feature Id="Main" Title="$(var.ProductName)" Level="1" AllowAbsent="no"
             Description="RViz with a private ROS Noetic runtime (roscore, rostopic, ...)."
             Display="expand">
      <ComponentGroupRef Id="Payload" />
      <ComponentGroupRef Id="CoreRegistration" />

      <Feature Id="StartMenu" Title="Start menu shortcuts" Level="1">
        <ComponentRef Id="StartMenuShortcuts" />
      </Feature>
      <Feature Id="Desktop" Title="Desktop shortcut" Level="1000">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
      <Feature Id="AddToPath" Title="Add launchers to system PATH" Level="1"
               Description="Lets you run rviz, roscore, rostopic, ... from any command prompt.">
        <ComponentGroupRef Id="PathGroup" />
      </Feature>
    </Feature>

    <!-- ===== UI ================================================================= -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsDir)\license.rtf" />
  </Package>
</Wix>
