diff --git a/src/rviz/ogre_helpers/render_system.cpp b/src/rviz/ogre_helpers/render_system.cpp
index 4005f98..1c02157 100644
--- a/src/rviz/ogre_helpers/render_system.cpp
+++ b/src/rviz/ogre_helpers/render_system.cpp
@@ -27,6 +27,8 @@
  * POSSIBILITY OF SUCH DAMAGE.
  */
 
+#include <cstdlib>
+
 #include <QMetaType>
 
 // This is required for QT_MAC_USE_COCOA to be set
@@ -159,7 +161,29 @@ void RenderSystem::setupDummyWindowId()
 
 void RenderSystem::loadOgrePlugins()
 {
-  std::string plugin_prefix = get_ogre_plugin_path() + "/";
+  // Relocatable plugin lookup (Windows MSI / conda builds):
+  //   1. RVIZ_OGRE_PLUGIN_DIR  - explicit override
+  //   2. CONDA_PREFIX          - <prefix>\Library\bin (Windows) or <prefix>/lib/OGRE
+  //   3. compile-time OGRE_PLUGIN_DIR (upstream behaviour)
+  std::string plugin_prefix;
+  const char* plugin_dir_env = std::getenv("RVIZ_OGRE_PLUGIN_DIR");
+  const char* conda_prefix_env = std::getenv("CONDA_PREFIX");
+  if (plugin_dir_env && *plugin_dir_env)
+  {
+    plugin_prefix = std::string(plugin_dir_env) + "/";
+  }
+  else if (conda_prefix_env && *conda_prefix_env)
+  {
+#ifdef _WIN32
+    plugin_prefix = std::string(conda_prefix_env) + "\\Library\\bin\\";
+#else
+    plugin_prefix = std::string(conda_prefix_env) + "/lib/OGRE/";
+#endif
+  }
+  else
+  {
+    plugin_prefix = get_ogre_plugin_path() + "/";
+  }
 #ifdef Q_OS_MAC
   plugin_prefix += "lib";
 #endif
